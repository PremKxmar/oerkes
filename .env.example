# Copy to .env (git-ignored) and fill in. Never commit .env.

# Local Conductor in Docker (no login needed):
CONDUCTOR_SERVER_URL=http://localhost:8080/api

# Orkes cluster: use an application access key, not a UI username/password.
# Orkes UI > Applications > create application > create access key.
# CONDUCTOR_SERVER_URL=https://<your-cluster>.orkesconductor.io/api
# CONDUCTOR_AUTH_KEY=
# CONDUCTOR_AUTH_SECRET=

# Optional: lets the POC 2 compare agent use an LLM. Without it the agent
# uses its built-in rules.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Owner email stamped on task and workflow definitions.
# OWNER_EMAIL=
